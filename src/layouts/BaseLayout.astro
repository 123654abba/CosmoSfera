---
import { BookOpen, Compass, Home, Library, Menu, Search, Sparkles } from "lucide-astro";
import LiveCosmos from "../components/LiveCosmos.astro";
import { withBase } from "../utils/paths";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  lang?: "ru" | "en";
}

const {
  title,
  lang = "ru",
  description = lang === "en"
    ? "CosmoSfera: a scientific atlas of habitable worlds, observation methods, missions, data sources, and careful interpretation."
    : "Космосфера: научный атлас обитаемых миров. Статьи, глоссарий, реальные миссии и источники о том, как наука ищет условия для жизни за пределами Земли."
} = Astro.props;
const isEnglish = lang === "en";
const pageTitle = title === "Космосфера" || title === "CosmoSfera" ? title : `${title} | ${isEnglish ? "CosmoSfera" : "Космосфера"}`;
const nav = isEnglish
  ? {
      aria: "Primary navigation",
      brandAria: "CosmoSfera, go to home page",
      home: "Home",
      worlds: "Habitable worlds",
      methods: "Methods",
      environment: "Cosmic environment",
      knowledge: "Knowledge map",
      glossary: "Glossary",
      materials: "Sources",
      menu: "Sections",
      switchLabel: "RU",
      switchHref: "/",
      switchAria: "Switch to Russian"
    }
  : {
      aria: "Основная навигация",
      brandAria: "Космосфера, на главную",
      home: "Главная",
      worlds: "Обитаемые миры",
      methods: "Методы и модели",
      environment: "Космическая среда",
      knowledge: "Карта знаний",
      glossary: "Глоссарий",
      materials: "Материалы",
      menu: "Разделы",
      switchLabel: "EN",
      switchHref: "/en/",
      switchAria: "Switch to English"
    };
const homeHref = isEnglish ? "/en/" : "/";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="cosmic-backdrop" aria-hidden="true">
      <LiveCosmos />
      <span class="meteor meteor-one"></span>
      <span class="meteor meteor-two"></span>
      <span class="meteor meteor-three"></span>
      <span class="orbit-line orbit-one"></span>
      <span class="orbit-line orbit-two"></span>
    </div>
    <header class="site-header">
      <nav class="nav container" aria-label={nav.aria}>
        <a class="brand" href={withBase(homeHref)} aria-label={nav.brandAria}>
          <span class="brand-mark"><Sparkles size={20} aria-hidden="true" /></span>
          <span>{isEnglish ? "CosmoSfera" : "Космосфера"}</span>
        </a>
        <div class="nav-links">
          <a href={withBase(homeHref)}><Home size={17} aria-hidden="true" /> {nav.home}</a>
          <a href={withBase("/sections/planetology/")}><Library size={17} aria-hidden="true" /> {nav.worlds}</a>
          <a href={withBase("/sections/astrophysics/")}><Search size={17} aria-hidden="true" /> {nav.methods}</a>
          <a href={withBase("/sections/astronomy/")}><BookOpen size={17} aria-hidden="true" /> {nav.environment}</a>
          <a href={withBase("/knowledge/")}><Compass size={17} aria-hidden="true" /> {nav.knowledge}</a>
          <a href={withBase("/glossary/")}>{nav.glossary}</a>
          <a href={withBase("/materials/")}>{nav.materials}</a>
          <a class="language-switch" href={withBase(nav.switchHref)} aria-label={nav.switchAria}>{nav.switchLabel}</a>
        </div>
        <details class="mobile-nav-menu">
          <summary><Menu size={18} aria-hidden="true" /> {nav.menu}</summary>
          <div class="mobile-nav-panel">
            <a href={withBase(homeHref)}><Home size={17} aria-hidden="true" /> {nav.home}</a>
            <a href={withBase("/sections/planetology/")}><Library size={17} aria-hidden="true" /> {nav.worlds}</a>
            <a href={withBase("/sections/astrophysics/")}><Search size={17} aria-hidden="true" /> {nav.methods}</a>
            <a href={withBase("/sections/astronomy/")}><BookOpen size={17} aria-hidden="true" /> {nav.environment}</a>
            <a href={withBase("/knowledge/")}><Compass size={17} aria-hidden="true" /> {nav.knowledge}</a>
            <a href={withBase("/glossary/")}>{nav.glossary}</a>
            <a href={withBase("/materials/")}>{nav.materials}</a>
            <a class="language-switch" href={withBase(nav.switchHref)} aria-label={nav.switchAria}>{nav.switchLabel}</a>
          </div>
        </details>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-inner container">
        <p>{isEnglish ? "CosmoSfera: a scientific atlas of habitable worlds." : "Космосфера: научный атлас обитаемых миров."}</p>
        <p>
          {isEnglish
            ? "Materials rely on open scientific sources, missions, data catalogs, and careful interpretation of observations."
            : "Материалы опираются на открытые научные источники, миссии, каталоги данных и осторожную интерпретацию наблюдений."}
        </p>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const motion = window.matchMedia("(prefers-reduced-motion: reduce)");

        function targetFromHash(hash) {
          if (!hash || hash === "#") return null;
          const id = decodeURIComponent(hash.slice(1));
          return document.getElementById(id);
        }

        function scrollToHash(hash, updateUrl = true) {
          const target = targetFromHash(hash);
          if (!target) return false;

          if (updateUrl && window.location.hash !== hash) {
            history.pushState(null, "", `${window.location.pathname}${window.location.search}${hash}`);
          }

          const header = document.querySelector(".site-header");
          const headerHeight = header ? header.getBoundingClientRect().height : 0;
          const top = Math.max(0, target.getBoundingClientRect().top + window.scrollY - headerHeight - 16);
          const scrollRoot = document.scrollingElement || document.documentElement;
          scrollRoot.scrollTop = top;
          document.documentElement.scrollTop = top;
          document.body.scrollTop = top;

          if (!motion.matches && typeof window.scrollTo === "function") {
            window.scrollTo({ top, behavior: "smooth" });
          }

          return true;
        }

        document.addEventListener("click", (event) => {
          const link = event.target.closest('a[href^="#"]');
          if (!link) return;

          const href = link.getAttribute("href");
          if (!href || href === "#") return;

          if (scrollToHash(href)) {
            event.preventDefault();
          }
        });

        window.addEventListener("hashchange", () => {
          scrollToHash(window.location.hash, false);
        });

        let lastHash = window.location.hash;
        window.setInterval(() => {
          if (window.location.hash && window.location.hash !== lastHash) {
            lastHash = window.location.hash;
            scrollToHash(window.location.hash, false);
          }
        }, 120);

        if (window.location.hash) {
          requestAnimationFrame(() => scrollToHash(window.location.hash, false));
        }
      })();
    </script>
  </body>
</html>
