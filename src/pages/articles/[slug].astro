---
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { getSection } from "@data/sections";
import { assetPath, withBase } from "../../utils/paths";

export async function getStaticPaths() {
  const articles = await getCollection("articles");
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article }
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const section = getSection(article.data.section);
const date = new Intl.DateTimeFormat("ru-RU", { dateStyle: "long" }).format(article.data.updatedAt);
const allArticles = await getCollection("articles");
const relatedArticles = allArticles
  .filter((entry) => entry.id !== article.id)
  .map((entry) => {
    const sharedTags = entry.data.tags.filter((tag) => article.data.tags.includes(tag)).length;
    const sameSection = entry.data.section === article.data.section ? 2 : 0;
    return { entry, score: sameSection + sharedTags };
  })
  .filter((item) => item.score > 0)
  .sort((a, b) => b.score - a.score || b.entry.data.updatedAt.valueOf() - a.entry.data.updatedAt.valueOf())
  .slice(0, 3)
  .map((item) => item.entry);
---

<BaseLayout title={article.data.title} description={article.data.description}>
  <article class="prose">
    <p class="eyebrow">{section?.title} · {article.data.level === "advanced" ? "Продвинутый" : "Средний"}</p>
    <h1>{article.data.title}</h1>
    <p class="lead">{article.data.description}</p>
    <figure class="article-hero">
      <img src={assetPath(article.data.heroImage)} alt={article.data.heroAlt} />
      <figcaption class="caption">{article.data.heroAlt}</figcaption>
    </figure>
    <div class="article-meta">
      <span>Обновлено: {date}</span>
      <span>Теги: {article.data.tags.join(", ")}</span>
    </div>
    {article.data.relatedTopics.length > 0 && (
      <div class="topic-list article-topics" aria-label="Связанные темы">
        {article.data.relatedTopics.map((topic) => <span class="chip">{topic}</span>)}
      </div>
    )}
    <Content />
    {relatedArticles.length > 0 && (
      <>
        <h2>Дальше читать</h2>
        <div class="related-strip">
          {relatedArticles.map((related) => (
            <a class="related-link" href={withBase(`/articles/${related.id}/`)}>
              <span>{getSection(related.data.section)?.title}</span>
              <strong>{related.data.title}</strong>
            </a>
          ))}
        </div>
      </>
    )}
    <h2>Источники</h2>
    <ul class="source-list">
      {article.data.sources.map((source) => (
        <li><a href={source.url} target="_blank" rel="noreferrer">{source.label}</a></li>
      ))}
    </ul>
  </article>
</BaseLayout>
