---
import {
  ArrowRight,
  BookOpenCheck,
  Compass,
  Database,
  LibraryBig,
  Microscope,
  Network,
  Radio,
  Telescope
} from "lucide-astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { sections } from "@data/sections";
import { assetPath, withBase } from "../../utils/paths";

const articles = await getCollection("articles");
const terms = await getCollection("glossary");
const resources = await getCollection("resources");
const heroSection = sections[0];

const scienceStats = [
  { value: articles.length, label: "articles", detail: "worlds, methods, atmospheres, missions, and cosmic context" },
  { value: terms.length, label: "terms", detail: "a compact vocabulary for reading the atlas" },
  { value: resources.length, label: "sources", detail: "missions, archives, catalogs, and scientific references" },
  { value: sections.length, label: "research tracks", detail: "world, signal, model, and careful conclusion" }
];

const atlasProtocol = [
  {
    title: "World",
    text: "Start with the physical environment: water, energy, chemistry, atmosphere, surface, orbit, and the host star.",
    icon: Telescope
  },
  {
    title: "Signal",
    text: "Look for measurable traces: spectra, transits, light curves, plume particles, minerals, or mission data.",
    icon: Database
  },
  {
    title: "Check",
    text: "Connect the signal to a model, then test whether instrument noise, stellar activity, or non-biological chemistry could explain it.",
    icon: Network
  }
];

const concepts = [
  {
    label: "condition",
    term: "Habitable zone",
    text: "The range of distances where liquid water could persist on a planet with suitable atmospheric pressure. It is not proof of habitability by itself."
  },
  {
    label: "signal",
    term: "Biosignature",
    text: "An observable feature that may be linked to life, such as a persistent atmospheric imbalance. It must be tested against non-biological explanations."
  },
  {
    label: "measurement",
    term: "Spectrum",
    text: "Light split by wavelength. Absorption and emission lines can reveal atoms, molecules, temperature, and the influence of a star."
  },
  {
    label: "method",
    term: "Transit method",
    text: "A planet is detected when it slightly dims its star while crossing the stellar disk. Repeated transits reveal size and orbital period."
  },
  {
    label: "environment",
    term: "Exoplanet atmosphere",
    text: "A gaseous envelope that shapes temperature, pressure, chemistry, and atmospheric loss. It is usually studied indirectly through spectra."
  },
  {
    label: "energy",
    term: "Tidal heating",
    text: "Internal heat generated by gravitational stretching. It can help maintain subsurface oceans on icy moons."
  }
];

const domains = [
  {
    title: "Habitable worlds",
    description: "Planets and moons are treated as physical systems: water, energy, chemistry, geology, and atmospheric stability.",
    href: "/sections/planetology/",
    tags: ["water", "energy", "chemistry"]
  },
  {
    title: "Methods and models",
    description: "Transits, spectra, radial velocities, and mission data turn distant objects into measurable evidence.",
    href: "/sections/astrophysics/",
    tags: ["spectra", "transits", "models"]
  },
  {
    title: "Cosmic environment",
    description: "A world cannot be read without its star, radiation field, galactic context, and observational limits.",
    href: "/sections/astronomy/",
    tags: ["stars", "radiation", "scale"]
  }
];

const materials = [
  {
    title: "Habitable worlds: what can be claimed carefully",
    description: "A framework for reading water, energy, chemistry, and uncertainty without jumping from conditions to life.",
    href: "/articles/habitable-worlds-framework/",
    section: "worlds",
    focus: "water and energy"
  },
  {
    title: "Biosignatures: why one gas is not proof",
    description: "A scientific signal becomes meaningful only after false positives and non-biological pathways are tested.",
    href: "/articles/biosignatures/",
    section: "atmospheres",
    focus: "cautious inference"
  },
  {
    title: "Spectra: reading atmospheres through light",
    description: "Spectroscopy links molecules, temperature, and stellar effects to the data we can actually measure.",
    href: "/articles/spectra/",
    section: "methods",
    focus: "wavelengths"
  },
  {
    title: "Icy moons and subsurface oceans",
    description: "Europa and Enceladus show why habitability can exist far from the classical habitable zone.",
    href: "/articles/icy-moons/",
    section: "worlds",
    focus: "subsurface oceans"
  },
  {
    title: "Stellar activity and habitability",
    description: "Flares, radiation, and atmospheric loss can decide whether a promising orbit remains physically plausible.",
    href: "/articles/stellar-activity-habitability/",
    section: "environment",
    focus: "host stars"
  },
  {
    title: "Telescopes and light",
    description: "The instruments behind the atlas: what telescopes measure, and why wavelength range matters.",
    href: "/articles/telescopes-and-light/",
    section: "missions",
    focus: "instruments"
  }
];

const evidenceScale = [
  {
    label: "observation",
    title: "What is measured",
    text: "Images, spectra, transits, radial velocities, plume particles, and surface geology provide the initial signal."
  },
  {
    label: "model",
    title: "How it is explained",
    text: "A physical model connects the signal to an ocean, atmosphere, orbit, chemistry, or planetary history."
  },
  {
    label: "limit",
    title: "Where caution starts",
    text: "The same signal can have several causes, so strong conclusions need repeated data and independent methods."
  }
];

const worlds = [
  {
    name: "Europa",
    category: "Icy moon",
    summary: "Jupiter's icy moon is a major target for studying subsurface oceans and possible chemically active environments.",
    signal: "surface geology and gravity-magnetic data are consistent with an ocean beneath the ice shell",
    evidence: "a strong ocean-world hypothesis now tested by Europa Clipper",
    limitation: "ocean composition, energy exchange, and surface-ocean connection still require direct constraints",
    facts: ["Jupiter", "ice shell", "subsurface ocean"],
    href: "/articles/icy-moons/"
  },
  {
    name: "Enceladus",
    category: "Icy moon",
    summary: "Saturn's small moon ejects water vapor and ice grains, giving rare access to material from an internal ocean.",
    signal: "plumes carry water, salts, and organic compounds from the moon's interior",
    evidence: "Cassini flew through the plumes and measured particles directly",
    limitation: "water and organic chemistry are not the same as detected biology",
    facts: ["Saturn", "plumes", "salty ocean"],
    href: "/articles/icy-moons/"
  },
  {
    name: "TRAPPIST-1e",
    category: "Rocky exoplanet",
    summary: "An Earth-size planet in a compact system around a cool red star, useful for testing atmospheres through transits.",
    signal: "repeated transits allow size estimates and atmospheric searches",
    evidence: "the system geometry is favorable for transmission spectroscopy",
    limitation: "a dense atmosphere and surface liquid water are not confirmed",
    facts: ["red dwarf", "transits", "habitable zone"],
    href: "/articles/exoplanets/"
  },
  {
    name: "Proxima Centauri b",
    category: "Nearest exoplanet",
    summary: "A planet around the closest star to the Sun, scientifically compelling but difficult because of stellar activity.",
    signal: "stellar radial-velocity motion indicates a planet with a near-Earth minimum mass",
    evidence: "detected by radial velocity, not by a direct surface image",
    limitation: "its atmosphere is unknown and may be affected by flares",
    facts: ["4.2 light-years", "radial velocity", "M dwarf"],
    href: "/articles/stellar-activity-habitability/"
  }
];
---

<BaseLayout
  title="CosmoSfera"
  lang="en"
  description="CosmoSfera: a scientific atlas of habitable worlds, observation methods, atmospheres, missions, and careful interpretation."
>
  <section class="container atlas-hero" aria-labelledby="atlas-title">
    <div class="atlas-hero-copy">
      <p class="eyebrow">CosmoSfera · Scientific atlas of habitable worlds</p>
      <h1 id="atlas-title">How science searches for worlds where life could be possible</h1>
      <p class="lead">
        No loud claims, no shortcuts: water, energy, chemistry, atmospheres, stars, missions, and measurable signals are organized into one route from data to careful conclusion.
      </p>
      <div class="hero-actions atlas-actions">
        <a class="button primary" href="#english-worlds">
          <Compass size={18} aria-hidden="true" /> Open the atlas
        </a>
        <a class="button" href="#english-concepts">
          <BookOpenCheck size={18} aria-hidden="true" /> Key concepts
        </a>
        <a class="button" href={withBase("/")}>
          <ArrowRight size={18} aria-hidden="true" /> Русская версия
        </a>
      </div>

      <div class="signal-strip" aria-label="Core research lines">
        <span><Radio size={16} aria-hidden="true" /> water and energy</span>
        <span><Microscope size={16} aria-hidden="true" /> atmospheres and spectra</span>
        <span><LibraryBig size={16} aria-hidden="true" /> missions and data</span>
      </div>
    </div>

    <aside class="observatory-panel" aria-label="Observation panel">
      <figure class="observatory-image">
        <img src={assetPath(heroSection.image)} alt="Europa, an icy moon of Jupiter with a cracked surface" />
        <figcaption>
          <strong>Europa</strong>
          <span>icy crust · probable ocean · NASA and ESA missions</span>
        </figcaption>
      </figure>
      <div class="observation-readout">
        <p class="eyebrow">Observation passport</p>
        <dl>
          <div>
            <dt>Object</dt>
            <dd>icy moon of Jupiter</dd>
          </div>
          <div>
            <dt>Method</dt>
            <dd>images, spectra, magnetic data, gravity data, and mission flybys</dd>
          </div>
          <div>
            <dt>Question</dt>
            <dd>could an ocean under the ice support a chemically active environment?</dd>
          </div>
        </dl>
      </div>
    </aside>
  </section>

  <section class="container science-spine" aria-label="Research method">
    <div class="spine-intro">
      <p class="eyebrow">Research method</p>
      <h2>From world to testable signal</h2>
      <p>
        Habitability is not a claim about life. It starts with the physical environment and the data that can be measured: images, spectra, stars, surfaces, and missions.
      </p>
    </div>
    <div class="spine-steps">
      {atlasProtocol.map((step, index) => {
        const Icon = step.icon;
        return (
          <article class="spine-step">
            <span class="step-index">0{index + 1}</span>
            <Icon size={22} aria-hidden="true" />
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        );
      })}
    </div>
  </section>

  <section class="container portal-stats atlas-stats" aria-label="Site summary">
    {scienceStats.map((item) => (
      <div>
        <strong>{item.value}</strong>
        <span>{item.label}</span>
        <small>{item.detail}</small>
      </div>
    ))}
  </section>

  <section id="english-concepts" class="container concepts-atlas">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Terms and limits</p>
        <h2>Key concepts</h2>
      </div>
      <p>Terms that help read the materials as a scientific atlas: from observation and measurement to model and cautious inference.</p>
    </div>
    <div class="concept-grid">
      {concepts.map((concept, index) => (
        <article class="concept-card">
          <span>
            <b>{String(index + 1).padStart(2, "0")}</b>
            {concept.label}
          </span>
          <h3>{concept.term}</h3>
          <p>{concept.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="english-atlas" class="container atlas-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Research domains</p>
        <h2>Worlds, methods, and cosmic context</h2>
      </div>
      <p>The atlas connects planetary environments, observational methods, and the stellar context that shapes habitability.</p>
    </div>
    <div class="grid three section-atlas">
      {domains.map((domain) => (
        <article class="card section-card section-card--textual english-domain-card">
          <a class="card-link" href={withBase(domain.href)} aria-label={`Open ${domain.title}`}></a>
          <div class="card-body">
            <div class="article-meta article-card-meta">
              <span>atlas station</span>
            </div>
            <h3>{domain.title}</h3>
            <p>{domain.description}</p>
            <div class="topic-list">
              {domain.tags.map((tag) => <span class="chip">{tag}</span>)}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="container article-lab">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Methods and explanations</p>
        <h2>Core reading route</h2>
      </div>
      <p>Selected materials are translated here as an English guide to the current Russian article base.</p>
    </div>
    <div class="article-catalog">
      {materials.map((item) => (
        <article class="card article-card article-card--catalog english-catalog-card" data-section={item.section} data-tags={item.focus} data-title={item.title.toLowerCase()}>
          <a class="card-link" href={withBase(item.href)} aria-label={`Open ${item.title}`}></a>
          <div class="card-body">
            <div class="article-meta article-card-meta">
              <span>{item.section}</span>
              <span>guide</span>
            </div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <div class="article-protocol">
              <span>Focus</span>
              <strong>{item.focus}</strong>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="english-worlds" class="container object-observatory world-observatory">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Atlas of worlds</p>
        <h2>Worlds and limits of evidence</h2>
      </div>
      <p>Short passports connect the object, the observed signal, the available data, and the point where interpretation must stay cautious.</p>
    </div>

    <div class="evidence-scale" aria-label="Evidence scale">
      {evidenceScale.map((item, index) => (
        <article>
          <span>{String(index + 1).padStart(2, "0")} · {item.label}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </article>
      ))}
    </div>

    <div class="object-ledger world-ledger">
      {worlds.map((world, index) => (
        <article class="object-row world-card">
          <div class="world-card-head">
            <span class="world-index">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <span>{world.category}</span>
              <h3>{world.name}</h3>
              <p>{world.summary}</p>
            </div>
          </div>

          <dl class="world-readout">
            <div>
              <dt>Signal</dt>
              <dd>{world.signal}</dd>
            </div>
            <div>
              <dt>Data</dt>
              <dd>{world.evidence}</dd>
            </div>
            <div>
              <dt>Limit</dt>
              <dd>{world.limitation}</dd>
            </div>
          </dl>

          <div class="topic-list world-facts">
            {world.facts.map((fact) => <span class="chip">{fact}</span>)}
          </div>

          <div class="topic-list world-links">
            <a class="chip" href={withBase(world.href)}>Related material</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
