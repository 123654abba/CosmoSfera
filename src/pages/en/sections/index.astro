---
import { ArrowRight, Compass } from "lucide-astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { sections } from "@data/sections";
import { getEnglishSection } from "@data/en";
import { assetPath, withBase } from "../../../utils/paths";

const articles = await getCollection("articles");
const articleCount = new Map<string, number>();

for (const article of articles) {
  articleCount.set(article.data.section, (articleCount.get(article.data.section) ?? 0) + 1);
}
---

<BaseLayout
  title="Atlas"
  lang="en"
  description="CosmoSfera atlas map: habitable worlds, methods and models, and the cosmic environment."
>
  <section class="container page-hero">
    <div>
      <p class="eyebrow">Portal map</p>
      <h1>Atlas of habitable worlds</h1>
    </div>
    <p class="lead">
      Choose an entry point: the worlds themselves, the methods used to test them, or the cosmic environment that shapes atmospheres, oceans, and surfaces.
    </p>
  </section>

  <section class="container">
    <div class="grid three section-atlas">
      {sections.map((section) => {
        const copy = getEnglishSection(section.id);
        const Icon = section.icon;

        return (
          <article class="card section-card section-card--visual" style={`--accent: ${section.accent}`}>
            <a class="card-link" href={withBase(copy?.href ?? `/en/sections/${section.id}/`)} aria-label={`Open ${copy?.title ?? section.title}`}></a>
            <img src={assetPath(section.image)} alt={section.imageAlt} loading="eager" decoding="async" />
            <div class="card-body">
              <div class="card-kicker" style="color: var(--accent)">
                <Icon size={19} aria-hidden="true" />
                <span>{copy?.short ?? section.short}</span>
              </div>
              <h3>{copy?.title ?? section.title}</h3>
              <p>{copy?.description ?? section.description}</p>
              <div class="topic-list" aria-label={`Topics in ${copy?.title ?? section.title}`}>
                {(copy?.topics ?? section.topics).map((topic) => <span class="chip">{topic}</span>)}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">How to navigate</p>
        <h2>Research station profiles</h2>
      </div>
      <p>Each station has its own type of evidence, method set, and scientific questions.</p>
    </div>
    <div class="grid three">
      {sections.map((section) => {
        const copy = getEnglishSection(section.id);

        return (
          <article class="card guide-card" style={`--accent: ${section.accent}`}>
            <div class="card-body">
              <div class="card-kicker" style="color: var(--accent)">
                <Compass size={18} aria-hidden="true" />
                <span>{copy?.short ?? section.short}</span>
              </div>
              <h3>{copy?.title ?? section.title}</h3>
              <p>{copy?.fieldGuide.signal ?? section.fieldGuide.signal}</p>
              <div class="guide-block">
                <strong>{articleCount.get(section.id) ?? 0} articles</strong>
                <span>Methods: {(copy?.fieldGuide.methods ?? section.fieldGuide.methods).join(", ")}</span>
              </div>
              <ul class="compact-list">
                {(copy?.fieldGuide.questions ?? section.fieldGuide.questions).slice(0, 2).map((question) => <li>{question}</li>)}
              </ul>
              <a class="button" href={withBase(copy?.href ?? `/en/sections/${section.id}/`)}>
                Open section <ArrowRight size={18} aria-hidden="true" />
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
