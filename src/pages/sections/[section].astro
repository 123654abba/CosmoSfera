---
import ArticleCard from "@components/ArticleCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { getSection, sections } from "@data/sections";
import { assetPath } from "../../utils/paths";

export function getStaticPaths() {
  return sections.map((section) => ({
    params: { section: section.id }
  }));
}

const sectionId = Astro.params.section ?? "";
const section = getSection(sectionId);
const articles = (await getCollection("articles", ({ data }) => data.section === sectionId)).sort(
  (a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf()
);
---

<BaseLayout title={section?.title ?? "Раздел"}>
  <div class="container hero">
    <div class="hero-copy">
      <p class="eyebrow">{section?.short}</p>
      <h1>{section?.title}</h1>
      <p class="lead">{section?.description}</p>
      <div class="topic-list" style="margin-top: 24px">
        {section?.topics.map((topic) => <span class="chip">{topic}</span>)}
      </div>
    </div>
    {section && (
      <figure class="hero-visual">
        <img src={assetPath(section.image)} alt={section.imageAlt} />
        <figcaption class="caption">{section.imageAlt}</figcaption>
      </figure>
    )}
  </div>

  {section && (
    <section class="container section-brief">
      <article class="card guide-card" style={`--accent: ${section.accent}`}>
        <div class="card-body">
          <p class="eyebrow">Навигация</p>
          <h2>Как пользоваться разделом</h2>
          <p>{section.fieldGuide.signal}</p>
          <div class="guide-block">
            <strong>{articles.length} материала в разделе</strong>
            <span>Методы: {section.fieldGuide.methods.join(", ")}</span>
          </div>
        </div>
      </article>
      <article class="card guide-card" style={`--accent: ${section.accent}`}>
        <div class="card-body">
          <p class="eyebrow">Что выясняем</p>
          <h2>Главные вопросы</h2>
          <ul class="compact-list">
            {section.fieldGuide.questions.map((question) => <li>{question}</li>)}
          </ul>
        </div>
      </article>
      <article class="card guide-card" style={`--accent: ${section.accent}`}>
        <div class="card-body">
          <p class="eyebrow">Практика</p>
          <h2>Что тренируем</h2>
          <ul class="compact-list">
            {section.fieldGuide.practice.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </article>
    </section>
  )}

  <section class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Материалы раздела</p>
        <h2>Статьи</h2>
      </div>
      <p>Материалы отсортированы по дате обновления и связаны с терминами, объектами и источниками.</p>
    </div>
    <div class="article-catalog">
      {articles.map((article) => <ArticleCard article={article} />)}
    </div>
  </section>
</BaseLayout>
