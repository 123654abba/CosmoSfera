---
import {
  ArrowRight,
  BookOpenCheck,
  Compass,
  Database,
  LibraryBig,
  Microscope,
  Network,
  Radio,
  Telescope
} from "lucide-astro";
import ArticleCard from "@components/ArticleCard.astro";
import FilterControls from "@components/FilterControls.astro";
import SectionCard from "@components/SectionCard.astro";
import UniverseTimeline from "@components/UniverseTimeline.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { objects } from "@data/objects";
import { sections } from "@data/sections";
import { withBase } from "../utils/paths";

const articles = (await getCollection("articles")).sort(
  (a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf()
);
const terms = await getCollection("glossary");
const resources = await getCollection("resources");

const scienceStats = [
  { value: articles.length, label: "статей", detail: "о мирах, методах и космической среде" },
  { value: terms.length, label: "терминов", detail: "язык обитаемости без перегруза" },
  { value: resources.length, label: "источников", detail: "миссии, архивы и каталоги данных" },
  { value: sections.length, label: "станции", detail: "мир, сигнал и проверка" }
];

const atlasProtocol = [
  {
    title: "Мир",
    text: "Сначала описываем систему: где есть вода, энергия, химический обмен, атмосфера, поверхность или океан под льдом.",
    icon: Telescope
  },
  {
    title: "Сигнал",
    text: "Потом ищем измеряемый след: спектральную линию, транзит, рельеф, минерал, кривую блеска или данные пролета миссии.",
    icon: Database
  },
  {
    title: "Проверка",
    text: "Затем связываем сигнал с моделью и проверяем, не объясняется ли он активностью звезды, шумом инструмента или неполными данными.",
    icon: Network
  }
];

const learningPaths = [
  {
    title: "Мир как система",
    description: "Планета или спутник рассматривается как связка воды, энергии, химии, поверхности и истории, а не как отдельная красивая картинка.",
    steps: ["вода", "энергия", "химия"],
    href: "/articles/icy-moons/"
  },
  {
    title: "Атмосфера по свету",
    description: "Спектры, транзиты и повторные наблюдения показывают, что можно сказать о составе далекого мира и где вывод пока слабый.",
    steps: ["спектры", "транзиты", "молекулы"],
    href: "/articles/spectra/"
  },
  {
    title: "Звезда и среда",
    description: "Обитаемость нельзя оценивать без звезды: излучение, вспышки, возраст и расстояние задают условия для атмосферы и поверхности.",
    steps: ["звезда", "излучение", "масштаб"],
    href: "/articles/telescopes-and-light/"
  }
];

const keyConcepts = [
  {
    label: "условие",
    term: "Обитаемая зона",
    text: "Диапазон расстояний от звезды, где при достаточном атмосферном давлении на поверхности планеты может существовать жидкая вода. Эта зона не доказывает обитаемость: важны состав атмосферы, активность звезды и история планеты."
  },
  {
    label: "сигнал",
    term: "Биосигнатура",
    text: "Наблюдаемый признак, который может быть связан с биологическими процессами, например устойчивое сочетание газов в атмосфере. Такой сигнал требует проверки, потому что похожие следы иногда возникают без участия жизни."
  },
  {
    label: "измерение",
    term: "Спектр",
    text: "Распределение света по длинам волн, в котором видны линии поглощения и излучения атомов или молекул. По спектру оценивают состав атмосферы, температуру и влияние звезды, но слабые сигналы требуют повторных измерений."
  },
  {
    label: "метод",
    term: "Транзитный метод",
    text: "Метод поиска планет по небольшому падению яркости звезды, когда планета проходит перед ее диском. Он дает период обращения и размер планеты, а дополнительные данные помогают уточнить массу и свойства атмосферы."
  },
  {
    label: "среда",
    term: "Атмосфера экзопланеты",
    text: "Газовая оболочка влияет на температуру, давление, химический состав и потерю вещества в космос. Ее изучают по спектрам во время транзитов, затмений и прямых наблюдений, отделяя сигнал планеты от света звезды."
  },
  {
    label: "энергия",
    term: "Приливный нагрев",
    text: "Выделение тепла внутри тела из-за гравитационного растяжения со стороны планеты, звезды или соседних спутников. Такой нагрев может поддерживать подледные океаны, но его сила зависит от орбиты и внутреннего строения объекта."
  }
];

const evidenceScale = [
  {
    label: "наблюдение",
    title: "Что измерено",
    text: "Снимок, спектр, транзит, движение звезды, состав частиц или геологическая форма дают исходный сигнал."
  },
  {
    label: "модель",
    title: "Как это объясняется",
    text: "Физическая модель связывает сигнал с океаном, атмосферой, орбитой, химией или историей поверхности."
  },
  {
    label: "ограничение",
    title: "Где осторожность",
    text: "Даже сильный сигнал может иметь несколько объяснений, поэтому вывод держится на повторных данных и независимых методах."
  }
];

const featuredObjectOrder = ["Европа", "Энцелад", "Титан", "TRAPPIST-1e", "Proxima Centauri b", "Jezero"];
const featuredObjects = [...objects]
  .sort((a, b) => {
    const left = featuredObjectOrder.indexOf(a.name);
    const right = featuredObjectOrder.indexOf(b.name);
    return (left === -1 ? 99 : left) - (right === -1 ? 99 : right);
  })
  .slice(0, 6);

const evidenceSteps = ["наблюдение", "модель", "ограничение"];
const worldPassportMeta = new Map([
  [
    "Европа",
    {
      code: "JOV-EUR",
      type: "ocean world",
      distance: "628,3 млн км",
      coordinate: "система Юпитера",
      marker: "лед · океан · приливы",
      confidence: 2,
      tone: "cyan"
    }
  ],
  [
    "Энцелад",
    {
      code: "SAT-ENC",
      type: "active plumes",
      distance: "1,27 млрд км",
      coordinate: "система Сатурна",
      marker: "шлейфы · соли · органика",
      confidence: 2,
      tone: "cyan"
    }
  ],
  [
    "Титан",
    {
      code: "SAT-TIT",
      type: "exotic chemistry",
      distance: "1,43 млрд км",
      coordinate: "система Сатурна",
      marker: "азот · метан · органика",
      confidence: 1,
      tone: "gold"
    }
  ],
  [
    "TRAPPIST-1e",
    {
      code: "TRP-1E",
      type: "rocky exoplanet",
      distance: "40,7 св. лет",
      coordinate: "звезда TRAPPIST-1",
      marker: "транзит · радиус · атмосфера",
      confidence: 1,
      tone: "green"
    }
  ],
  [
    "Proxima Centauri b",
    {
      code: "PROX-B",
      type: "nearest exoworld",
      distance: "4,2 св. года",
      coordinate: "красный карлик",
      marker: "лучевые скорости · вспышки",
      confidence: 1,
      tone: "gold"
    }
  ],
  [
    "Jezero",
    {
      code: "MRS-JEZ",
      type: "ancient delta",
      distance: "Марс",
      coordinate: "18,4° N · 77,6° E",
      marker: "дельта · осадки · керны",
      confidence: 2,
      tone: "red"
    }
  ]
]);
---

<BaseLayout
  title="Космосфера"
  description="Космосфера: научный атлас обитаемых миров с реальными изображениями, миссиями, источниками и связями между планетами, звездами и методами наблюдения."
>
  <section class="container atlas-hero figma-hero" aria-labelledby="atlas-title">
    <div class="atlas-hero-copy">
      <p class="eyebrow hero-kicker">scientific atlas · habitable worlds</p>
      <h1 id="atlas-title" class="cosmosfera-logotype">
        <span>Cosmo</span><span>Sfera</span>
      </h1>
      <p class="hero-subtitle">Научный атлас обитаемых миров</p>
      <p class="lead">
        Космосфера связывает мир, сигнал и предел вывода: от ледяных океанов и атмосфер экзопланет
        до миссий, спектров и моделей, которые показывают, где данные заканчиваются.
      </p>
      <div class="hero-actions atlas-actions">
        <a class="button primary" href="#world-atlas">
          <Compass size={18} aria-hidden="true" /> Смотреть атлас
        </a>
        <a class="button" href={withBase("/knowledge/")}>
          <BookOpenCheck size={18} aria-hidden="true" /> Карта знаний
        </a>
        <a class="button" href="#cosmic-timeline">
          <ArrowRight size={18} aria-hidden="true" /> Шкала миров
        </a>
      </div>

      <div class="signal-strip" aria-label="Ключевые линии исследования">
        <span><Radio size={16} aria-hidden="true" /> сигнал</span>
        <span><Microscope size={16} aria-hidden="true" /> данные</span>
        <span><LibraryBig size={16} aria-hidden="true" /> ограничение</span>
      </div>
    </div>

    <aside class="hero-command-panel" aria-label="Сводка научного атласа">
      <div class="command-panel-head">
        <span>scale</span>
        <strong>Наблюдение → модель → ограничение</strong>
      </div>
      <div class="hero-orbit-map" aria-hidden="true">
        <span class="orbit orbit-one"></span>
        <span class="orbit orbit-two"></span>
        <span class="orbit orbit-three"></span>
        <span class="world-dot dot-europa"></span>
        <span class="world-dot dot-titan"></span>
        <span class="world-dot dot-trappist"></span>
      </div>
      <div class="command-grid">
        {scienceStats.map((item) => (
          <div>
            <strong>{item.value}</strong>
            <span>{item.label}</span>
            <small>{item.detail}</small>
          </div>
        ))}
      </div>
      <dl class="hero-signal-stack">
        <div>
          <dt>Сигнал</dt>
          <dd>измеряемый след в свете, веществе, рельефе или движении</dd>
        </div>
        <div>
          <dt>Данные</dt>
          <dd>миссии, спектры, пролеты, транзиты и независимые каталоги</dd>
        </div>
        <div>
          <dt>Ограничение</dt>
          <dd>альтернативные объяснения, шум инструмента и неполная модель</dd>
        </div>
      </dl>
    </aside>
  </section>

  <section id="world-atlas" class="container atlas-dashboard world-observatory" aria-labelledby="world-atlas-title">
    <div class="atlas-dashboard-shell">
      <div class="atlas-dashboard-head">
        <div>
          <p class="eyebrow">atlas of worlds and limitations · 6 entries</p>
          <h2 id="world-atlas-title">Атлас миров и ограничений</h2>
          <p>
            Паспорта связывают объект, наблюдаемый сигнал и границу вывода: где есть данные,
            где работает модель, а где нужна научная осторожность.
          </p>
        </div>
        <div class="dashboard-scale" aria-label="Шкала доказательности">
          {evidenceSteps.map((step) => (
            <span>{step}</span>
          ))}
        </div>
      </div>

      <div class="evidence-scale dashboard-evidence" aria-label="Шкала научной осторожности">
        {evidenceScale.map((item, index) => (
          <article>
            <span>{String(index + 1).padStart(2, "0")} · {item.label}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>

      <div class="atlas-passport-grid">
        {featuredObjects.map((object, index) => {
          const signal = "signal" in object ? object.signal : object.keyFacts.join(" · ");
          const evidence = "evidence" in object ? object.evidence : "сводка по связанным материалам и наблюдениям";
          const limitation = "limitation" in object ? object.limitation : "детали зависят от метода наблюдения и полноты данных";
          const meta =
            worldPassportMeta.get(object.name) ??
            {
              code: `OBJ-${String(index + 1).padStart(2, "0")}`,
              type: object.category,
              distance: "каталог",
              coordinate: "сравнительная запись",
              marker: object.keyFacts.join(" · "),
              confidence: 1,
              tone: "cyan"
            };

          return (
            <article class={`world-passport world-passport--${meta.tone}`}>
              <div class="passport-topline">
                <span>{meta.code}</span>
                <span>{meta.type}</span>
              </div>

              <div class="passport-heading">
                <span class="world-index">{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <p class="passport-label">{object.category}</p>
                  <h3>{object.name}</h3>
                </div>
                <span class="passport-distance">{meta.distance}</span>
              </div>

              <p class="passport-summary">{object.summary}</p>

              <div class="passport-meta-line">
                <span>{meta.coordinate}</span>
                <span>{meta.marker}</span>
              </div>

              <dl class="passport-readout">
                <div class="readout-cell readout-signal">
                  <dt>Сигнал</dt>
                  <dd>{signal}</dd>
                </div>
                <div class="readout-cell readout-data">
                  <dt>Данные</dt>
                  <dd>{evidence}</dd>
                </div>
                <div class="readout-cell readout-limit">
                  <dt>Ограничение</dt>
                  <dd>{limitation}</dd>
                </div>
              </dl>

              <div class="confidence-line" aria-label={`Шкала доказательности: ${object.name}`}>
                {evidenceSteps.map((step, stepIndex) => (
                  <span class={`confidence-dot ${stepIndex <= meta.confidence ? "is-active" : ""}`}>{step}</span>
                ))}
              </div>

              <div class="topic-list world-facts">
                {object.keyFacts.map((fact) => <span class="chip">{fact}</span>)}
              </div>

              <div class="topic-list world-links" aria-label={`Статьи по теме ${object.name}`}>
                {object.relatedArticles.map((slug) => (
                  <a class="chip" href={withBase(`/articles/${slug}/`)}>
                    {articles.find((article) => article.id === slug)?.data.title ?? slug}
                  </a>
                ))}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="container science-spine" aria-label="Научная схема исследования">
    <div class="spine-intro">
      <p class="eyebrow">Метод исследования</p>
      <h2>От мира к проверяемому сигналу</h2>
      <p>
        Оценка обитаемости начинается не с вывода о жизни, а с условий среды и наблюдаемых данных.
        Снимки, спектры, звезды и миссии дают разные фрагменты одной физической картины.
      </p>
    </div>
    <div class="spine-steps">
      {atlasProtocol.map((step, index) => {
        const Icon = step.icon;
        return (
          <article class="spine-step">
            <span class="step-index">0{index + 1}</span>
            <Icon size={22} aria-hidden="true" />
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        );
      })}
    </div>
  </section>

  <section class="container portal-stats atlas-stats" aria-label="Сводка научных материалов">
    {scienceStats.map((item) => (
      <div>
        <strong>{item.value}</strong>
        <span>{item.label}</span>
        <small>{item.detail}</small>
      </div>
    ))}
  </section>

  <UniverseTimeline />

  <section class="container research-routes">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Наблюдательные маршруты</p>
        <h2>Мир, сигнал и ограничение</h2>
      </div>
      <p>Каждый маршрут связывает объект, метод наблюдения и границы того, что можно уверенно утверждать по данным.</p>
    </div>
    <div class="route-ledger">
      {learningPaths.map((path, index) => (
        <article class="route-row">
          <span class="route-number">{index + 1}</span>
          <div>
            <h3>{path.title}</h3>
            <p>{path.description}</p>
          </div>
          <div class="topic-list">
            {path.steps.map((step) => <span class="chip">{step}</span>)}
          </div>
          <a class="button" href={withBase(path.href)}>
            Начать <ArrowRight size={18} aria-hidden="true" />
          </a>
        </article>
      ))}
    </div>
  </section>

  <section class="container concepts-atlas">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Термины и ограничения</p>
        <h2>Ключевые понятия</h2>
      </div>
      <p>Термины, которые помогают читать материалы как научный атлас: от наблюдения и измерения до модели и осторожного вывода.</p>
    </div>
    <div class="concept-grid">
      {keyConcepts.map((concept, index) => (
        <article class="concept-card">
          <span>
            <b>{String(index + 1).padStart(2, "0")}</b>
            {concept.label}
          </span>
          <h3>{concept.term}</h3>
          <p>{concept.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="sections" class="container atlas-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Области исследования</p>
        <h2>Миры, методы и космическая среда</h2>
      </div>
      <p>Разделы показывают, как свойства планет, наблюдательные методы и условия у звезды вместе определяют оценку обитаемости.</p>
    </div>
    <div class="grid three section-atlas">
      {sections.map((section) => <SectionCard section={section} variant="textual" />)}
    </div>
  </section>

  <section class="container article-lab">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Методы и ограничения</p>
        <h2>Каталог наблюдений и объяснений</h2>
      </div>
      <p>Материалы сопоставляют наблюдения, модели и осторожные выводы: от спектров атмосфер до ледяных океанов и активности звезд.</p>
    </div>
    <FilterControls />
    <div class="article-catalog">
      {articles.map((article) => <ArticleCard article={article} variant="catalog" />)}
    </div>
    <p class="empty-state" data-empty-state>По этому запросу материалов пока нет.</p>
  </section>

</BaseLayout>
