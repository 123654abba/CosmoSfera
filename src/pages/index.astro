---
import {
  ArrowRight,
  BookOpenCheck,
  Compass,
  Database,
  LibraryBig,
  Microscope,
  Network,
  Radio,
  Telescope
} from "lucide-astro";
import ArticleCard from "@components/ArticleCard.astro";
import FilterControls from "@components/FilterControls.astro";
import SectionCard from "@components/SectionCard.astro";
import UniverseTimeline from "@components/UniverseTimeline.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { objects } from "@data/objects";
import { sections } from "@data/sections";
import { assetPath, withBase } from "../utils/paths";

const articles = (await getCollection("articles")).sort(
  (a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf()
);
const terms = await getCollection("glossary");
const resources = await getCollection("resources");
const heroSection = sections[0];

const scienceStats = [
  { value: articles.length, label: "статей", detail: "о мирах, методах и космической среде" },
  { value: terms.length, label: "терминов", detail: "язык обитаемости без перегруза" },
  { value: resources.length, label: "источников", detail: "миссии, архивы и каталоги данных" },
  { value: sections.length, label: "станции", detail: "мир, сигнал и проверка" }
];

const atlasProtocol = [
  {
    title: "Мир",
    text: "Сначала описываем систему: где есть вода, энергия, химический обмен, атмосфера, поверхность или океан под льдом.",
    icon: Telescope
  },
  {
    title: "Сигнал",
    text: "Потом ищем измеряемый след: спектральную линию, транзит, рельеф, минерал, кривую блеска или данные пролета миссии.",
    icon: Database
  },
  {
    title: "Проверка",
    text: "Затем связываем сигнал с моделью и проверяем, не объясняется ли он активностью звезды, шумом инструмента или неполными данными.",
    icon: Network
  }
];

const learningPaths = [
  {
    title: "Мир как система",
    description: "Планета или спутник рассматривается как связка воды, энергии, химии, поверхности и истории, а не как отдельная красивая картинка.",
    steps: ["вода", "энергия", "химия"],
    href: "/articles/icy-moons/"
  },
  {
    title: "Атмосфера по свету",
    description: "Спектры, транзиты и повторные наблюдения показывают, что можно сказать о составе далекого мира и где вывод пока слабый.",
    steps: ["спектры", "транзиты", "молекулы"],
    href: "/articles/spectra/"
  },
  {
    title: "Звезда и среда",
    description: "Обитаемость нельзя оценивать без звезды: излучение, вспышки, возраст и расстояние задают условия для атмосферы и поверхности.",
    steps: ["звезда", "излучение", "масштаб"],
    href: "/articles/telescopes-and-light/"
  }
];

const keyConcepts = [
  {
    label: "условие",
    term: "Обитаемая зона",
    text: "Диапазон расстояний от звезды, где при достаточном атмосферном давлении на поверхности планеты может существовать жидкая вода. Эта зона не доказывает обитаемость: важны состав атмосферы, активность звезды и история планеты."
  },
  {
    label: "сигнал",
    term: "Биосигнатура",
    text: "Наблюдаемый признак, который может быть связан с биологическими процессами, например устойчивое сочетание газов в атмосфере. Такой сигнал требует проверки, потому что похожие следы иногда возникают без участия жизни."
  },
  {
    label: "измерение",
    term: "Спектр",
    text: "Распределение света по длинам волн, в котором видны линии поглощения и излучения атомов или молекул. По спектру оценивают состав атмосферы, температуру и влияние звезды, но слабые сигналы требуют повторных измерений."
  },
  {
    label: "метод",
    term: "Транзитный метод",
    text: "Метод поиска планет по небольшому падению яркости звезды, когда планета проходит перед ее диском. Он дает период обращения и размер планеты, а дополнительные данные помогают уточнить массу и свойства атмосферы."
  },
  {
    label: "среда",
    term: "Атмосфера экзопланеты",
    text: "Газовая оболочка влияет на температуру, давление, химический состав и потерю вещества в космос. Ее изучают по спектрам во время транзитов, затмений и прямых наблюдений, отделяя сигнал планеты от света звезды."
  },
  {
    label: "энергия",
    term: "Приливный нагрев",
    text: "Выделение тепла внутри тела из-за гравитационного растяжения со стороны планеты, звезды или соседних спутников. Такой нагрев может поддерживать подледные океаны, но его сила зависит от орбиты и внутреннего строения объекта."
  }
];

const featuredObjectOrder = ["Европа", "TRAPPIST-1", "Jezero", "Солнце", "NGC 3324", "Млечный Путь"];
const featuredObjects = [...objects]
  .sort((a, b) => {
    const left = featuredObjectOrder.indexOf(a.name);
    const right = featuredObjectOrder.indexOf(b.name);
    return (left === -1 ? 99 : left) - (right === -1 ? 99 : right);
  })
  .slice(0, 6);
---

<BaseLayout
  title="Космосфера"
  description="Космосфера: научный атлас обитаемых миров с реальными изображениями, миссиями, источниками и связями между планетами, звездами и методами наблюдения."
>
  <section class="container atlas-hero" aria-labelledby="atlas-title">
    <div class="atlas-hero-copy">
      <p class="eyebrow">Космосфера · Научный атлас обитаемых миров</p>
      <h1 id="atlas-title">Как наука ищет миры, где возможна жизнь</h1>
      <p class="lead">
        Без фантастики и громких обещаний: вода, энергия, химия, атмосферы, звезды,
        миссии и проверяемые источники собраны в один маршрут от данных к осторожному выводу.
      </p>
      <div class="hero-actions atlas-actions">
        <a class="button primary" href={withBase("/sections/")}>
          <Compass size={18} aria-hidden="true" /> Открыть атлас
        </a>
        <a class="button" href={withBase("/knowledge/")}>
          <BookOpenCheck size={18} aria-hidden="true" /> Карта знаний
        </a>
        <a class="button" href="#cosmic-timeline">
          <ArrowRight size={18} aria-hidden="true" /> Шкала миров
        </a>
      </div>

      <div class="signal-strip" aria-label="Ключевые линии исследования">
        <span><Radio size={16} aria-hidden="true" /> вода и энергия</span>
        <span><Microscope size={16} aria-hidden="true" /> атмосферы и спектры</span>
        <span><LibraryBig size={16} aria-hidden="true" /> миссии и данные</span>
      </div>
    </div>

    <aside class="observatory-panel" aria-label="Панель наблюдения">
      <figure class="observatory-image">
        <img src={assetPath(heroSection.image)} alt={heroSection.imageAlt} />
        <figcaption>
          <strong>Европа</strong>
          <span>ледяная кора · вероятный океан · миссии NASA и ESA</span>
        </figcaption>
      </figure>
      <div class="observation-readout">
        <p class="eyebrow">Паспорт наблюдения</p>
        <dl>
          <div>
            <dt>Объект</dt>
            <dd>ледяной спутник Юпитера</dd>
          </div>
          <div>
            <dt>Метод</dt>
            <dd>снимки, спектры, магнитные и гравитационные данные</dd>
          </div>
          <div>
            <dt>Вопрос</dt>
            <dd>может ли океан под льдом поддерживать химически активную среду</dd>
          </div>
        </dl>
      </div>
    </aside>
  </section>

  <section class="container science-spine" aria-label="Научная схема исследования">
    <div class="spine-intro">
      <p class="eyebrow">Метод исследования</p>
      <h2>От мира к проверяемому сигналу</h2>
      <p>
        Оценка обитаемости начинается не с вывода о жизни, а с условий среды и наблюдаемых данных.
        Снимки, спектры, звезды и миссии дают разные фрагменты одной физической картины.
      </p>
    </div>
    <div class="spine-steps">
      {atlasProtocol.map((step, index) => {
        const Icon = step.icon;
        return (
          <article class="spine-step">
            <span class="step-index">0{index + 1}</span>
            <Icon size={22} aria-hidden="true" />
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        );
      })}
    </div>
  </section>

  <section class="container concepts-atlas">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Термины и ограничения</p>
        <h2>Ключевые понятия</h2>
      </div>
      <p>Термины, которые помогают читать материалы как научный атлас: от наблюдения и измерения до модели и осторожного вывода.</p>
    </div>
    <div class="concept-grid">
      {keyConcepts.map((concept, index) => (
        <article class="concept-card">
          <span>
            <b>{String(index + 1).padStart(2, "0")}</b>
            {concept.label}
          </span>
          <h3>{concept.term}</h3>
          <p>{concept.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="container portal-stats atlas-stats" aria-label="Сводка научных материалов">
    {scienceStats.map((item) => (
      <div>
        <strong>{item.value}</strong>
        <span>{item.label}</span>
        <small>{item.detail}</small>
      </div>
    ))}
  </section>

  <UniverseTimeline />

  <section class="container research-routes">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Наблюдательные маршруты</p>
        <h2>Мир, сигнал и ограничение</h2>
      </div>
      <p>Каждый маршрут связывает объект, метод наблюдения и границы того, что можно уверенно утверждать по данным.</p>
    </div>
    <div class="route-ledger">
      {learningPaths.map((path, index) => (
        <article class="route-row">
          <span class="route-number">{index + 1}</span>
          <div>
            <h3>{path.title}</h3>
            <p>{path.description}</p>
          </div>
          <div class="topic-list">
            {path.steps.map((step) => <span class="chip">{step}</span>)}
          </div>
          <a class="button" href={withBase(path.href)}>
            Начать <ArrowRight size={18} aria-hidden="true" />
          </a>
        </article>
      ))}
    </div>
  </section>

  <section id="sections" class="container atlas-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Области исследования</p>
        <h2>Миры, методы и космическая среда</h2>
      </div>
      <p>Разделы показывают, как свойства планет, наблюдательные методы и условия у звезды вместе определяют оценку обитаемости.</p>
    </div>
    <div class="grid three section-atlas">
      {sections.map((section) => <SectionCard section={section} />)}
    </div>
  </section>

  <section class="container article-lab">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Методы и ограничения</p>
        <h2>Каталог наблюдений и объяснений</h2>
      </div>
      <p>Материалы сопоставляют наблюдения, модели и осторожные выводы: от спектров атмосфер до ледяных океанов и активности звезд.</p>
    </div>
    <FilterControls />
    <div class="article-catalog">
      {articles.map((article) => <ArticleCard article={article} />)}
    </div>
    <p class="empty-state" data-empty-state>По этому запросу материалов пока нет.</p>
  </section>

  <section class="container object-observatory">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Атлас объектов</p>
        <h2>Объекты для сравнения</h2>
      </div>
      <p>Планеты, спутники, звезды и области звездообразования помогают сравнивать условия среды с реальными наблюдениями и миссиями.</p>
    </div>
    <div class="object-ledger">
      {featuredObjects.map((object) => (
        <article class="object-row">
          <div>
            <span>{object.category}</span>
            <h3>{object.name}</h3>
            <p>{object.summary}</p>
          </div>
          <div class="topic-list">
            {object.keyFacts.map((fact) => <span class="chip">{fact}</span>)}
          </div>
          <div class="topic-list" aria-label={`Статьи по теме ${object.name}`}>
            {object.relatedArticles.map((slug) => (
              <a class="chip" href={withBase(`/articles/${slug}/`)}>
                {articles.find((article) => article.id === slug)?.data.title ?? slug}
              </a>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

</BaseLayout>
