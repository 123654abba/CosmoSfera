---
import { ArrowRight, Compass, LibraryBig } from "lucide-astro";
import ArticleCard from "@components/ArticleCard.astro";
import FilterControls from "@components/FilterControls.astro";
import SectionCard from "@components/SectionCard.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { objects } from "@data/objects";
import { sections } from "@data/sections";
import { assetPath, withBase } from "../utils/paths";

const articles = (await getCollection("articles")).sort(
  (a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf()
);
const terms = await getCollection("glossary");
const resources = await getCollection("resources");
const heroSection = sections[0];
const learningPaths = [
  {
    title: "От снимка к физике",
    description: "Начните с красивого изображения, разберите диапазон света и перейдите к процессам внутри газа и звезд.",
    steps: ["Космические утесы", "Спектры", "Темная материя"],
    href: "/articles/cosmic-cliffs/"
  },
  {
    title: "Компактные объекты",
    description: "Разберите, как гравитация, аккреция и экстремальная плотность превращают звезды в лаборатории физики.",
    steps: ["Черные дыры", "Спектры", "Галактики"],
    href: "/articles/black-holes/"
  },
  {
    title: "Планеты как миры",
    description: "Посмотрите на поверхности, атмосферы, ледяные океаны и условия, которые делают планеты научно интересными.",
    steps: ["Экзопланеты", "Поверхности", "Ледяные спутники"],
    href: "/articles/exoplanets/"
  }
];
---

<BaseLayout title="Космосфера">
  <div class="container hero">
    <div class="hero-copy">
      <p class="eyebrow">Инфо-портал о космосе</p>
      <h1>Космос: астрономия, астрофизика и планетология.</h1>
      <p class="lead">
        Справочный портал для энтузиастов: наблюдения, физика космических процессов,
        планетные миры, глоссарий и проверенные источники для самостоятельного изучения.
      </p>
      <div class="hero-actions">
        <a class="button primary" href={withBase("/sections/")}>
          <Compass size={18} aria-hidden="true" /> Перейти к разделам
        </a>
        <a class="button" href={withBase("/materials/")}>
          <LibraryBig size={18} aria-hidden="true" /> Открыть материалы
        </a>
      </div>
    </div>
    <figure class="hero-visual">
      <img src={assetPath(heroSection.image)} alt={heroSection.imageAlt} />
      <figcaption class="caption">
        Космические утесы в туманности Киля. Изображение: NASA, ESA, CSA, STScI.
      </figcaption>
    </figure>
  </div>

  <section class="container portal-stats" aria-label="Сводка портала">
    <div>
      <strong>{articles.length}</strong>
      <span>статей</span>
    </div>
    <div>
      <strong>{terms.length}</strong>
      <span>терминов</span>
    </div>
    <div>
      <strong>{resources.length}</strong>
      <span>источников</span>
    </div>
    <div>
      <strong>{sections.length}</strong>
      <span>направления</span>
    </div>
  </section>

  <section class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Маршруты изучения</p>
        <h2>С чего начать</h2>
      </div>
      <p>Три коротких маршрута связывают статьи в осмысленную последовательность: от наблюдения к объяснению.</p>
    </div>
    <div class="grid three">
      {learningPaths.map((path) => (
        <article class="card path-card">
          <div class="card-body">
            <h3>{path.title}</h3>
            <p>{path.description}</p>
            <div class="topic-list">
              {path.steps.map((step) => <span class="chip">{step}</span>)}
            </div>
            <a class="button" href={withBase(path.href)}>
              Начать маршрут <ArrowRight size={18} aria-hidden="true" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="sections" class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Три главные темы</p>
        <h2>Разделы портала</h2>
      </div>
      <p>Каждый раздел ведет к статьям, терминам, объектам и внешним источникам.</p>
    </div>
    <div class="grid three">
      {sections.map((section) => <SectionCard section={section} />)}
    </div>
  </section>

  <section class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Популярные материалы</p>
        <h2>Статьи и темы</h2>
      </div>
      <p>Фильтруйте материалы по направлению или ищите по ключевым словам.</p>
    </div>
    <FilterControls />
    <div class="grid three" style="margin-top: 18px">
      {articles.map((article) => <ArticleCard article={article} />)}
    </div>
    <p class="empty-state" data-empty-state>По этому запросу материалов пока нет.</p>
  </section>

  <section class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Каталог объектов</p>
        <h2>Опорные примеры</h2>
      </div>
      <p>Объекты помогают связывать статьи с реальными наблюдениями, миссиями и данными.</p>
    </div>
    <div class="grid three">
      {objects.map((object) => (
        <article class="card object-card">
          <div class="card-body">
            <div class="article-meta"><span>{object.category}</span></div>
            <h3>{object.name}</h3>
            <p>{object.summary}</p>
            <div class="topic-list">
              {object.keyFacts.map((fact) => <span class="chip">{fact}</span>)}
            </div>
            <div class="topic-list" aria-label={`Статьи по теме ${object.name}`}>
              {object.relatedArticles.map((slug) => (
                <a class="chip" href={withBase(`/articles/${slug}/`)}>
                  {articles.find((article) => article.id === slug)?.data.title ?? slug}
                </a>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Быстрый вход</p>
        <h2>Глоссарий и источники</h2>
      </div>
      <p>Короткие определения и ссылки на надежные агентства, архивы, каталоги и миссии.</p>
    </div>
    <div class="hero-actions" style="margin-top: 0">
      <a class="button" href={withBase("/glossary/")}>Открыть глоссарий <ArrowRight size={18} aria-hidden="true" /></a>
      <a class="button" href={withBase("/materials/")}>Открыть материалы <ArrowRight size={18} aria-hidden="true" /></a>
    </div>
  </section>
</BaseLayout>
