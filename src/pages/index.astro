---
import { ArrowRight, Compass, LibraryBig } from "lucide-astro";
import ArticleCard from "@components/ArticleCard.astro";
import FilterControls from "@components/FilterControls.astro";
import SectionCard from "@components/SectionCard.astro";
import UniverseTimeline from "@components/UniverseTimeline.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { objects } from "@data/objects";
import { sections } from "@data/sections";
import { assetPath, withBase } from "../utils/paths";

const articles = (await getCollection("articles")).sort(
  (a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf()
);
const terms = await getCollection("glossary");
const resources = await getCollection("resources");
const heroSection = sections[0];
const learningPaths = [
  {
    title: "От изображения к физике",
    description: "Начните с реального снимка, разберите диапазон света и перейдите к процессам внутри газа, пыли и звезд.",
    steps: ["Космические утесы", "Спектры", "Темная материя"],
    href: "/articles/cosmic-cliffs/"
  },
  {
    title: "Компактные объекты",
    description: "Разберитесь, как гравитация, аккреция и экстремальная плотность помогают проверять физические модели.",
    steps: ["Черные дыры", "Спектры", "Галактики"],
    href: "/articles/black-holes/"
  },
  {
    title: "Планеты как системы",
    description: "Посмотрите, как рельеф, атмосферы, лед и океаны превращают планеты и спутники в отдельные истории.",
    steps: ["Экзопланеты", "Поверхности", "Ледяные спутники"],
    href: "/articles/exoplanets/"
  }
];
---

<BaseLayout title="Космосфера">
  <div class="container hero">
    <div class="hero-copy">
      <p class="eyebrow">Астрономия · Астрофизика · Планетология</p>
      <h1>Космосфера: навигатор по Вселенной</h1>
      <p class="lead">
        Портал для тех, кто хочет понимать космос глубже красивых снимков: наблюдения,
        физика экстремальных объектов, планетные миры, глоссарий и проверенные источники.
      </p>
      <div class="hero-actions">
        <a class="button primary" href={withBase("/sections/")}>
          <Compass size={18} aria-hidden="true" /> Изучить разделы
        </a>
        <a class="button" href={withBase("/materials/")}>
          <LibraryBig size={18} aria-hidden="true" /> Смотреть источники
        </a>
        <a class="button" href="#cosmic-timeline">
          <ArrowRight size={18} aria-hidden="true" /> Шкала Вселенной
        </a>
      </div>
    </div>
    <figure class="hero-visual">
      <img src={assetPath(heroSection.image)} alt={heroSection.imageAlt} />
      <figcaption class="caption">
        NGC 3324 в туманности Киля: область рождения звезд на снимке JWST. Изображение: NASA, ESA, CSA, STScI.
      </figcaption>
    </figure>
  </div>

  <section class="container portal-stats" aria-label="Сводка портала">
    <div>
      <strong>{articles.length}</strong>
      <span>статей</span>
    </div>
    <div>
      <strong>{terms.length}</strong>
      <span>терминов</span>
    </div>
    <div>
      <strong>{resources.length}</strong>
      <span>источников</span>
    </div>
    <div>
      <strong>{sections.length}</strong>
      <span>направления</span>
    </div>
  </section>

  <UniverseTimeline />

  <section class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Маршруты изучения</p>
        <h2>С чего начать изучение</h2>
      </div>
      <p>Три маршрута помогают двигаться не случайно, а по связям: от наблюдения к данным, от данных к объяснению.</p>
    </div>
    <div class="grid three">
      {learningPaths.map((path) => (
        <article class="card path-card">
          <div class="card-body">
            <h3>{path.title}</h3>
            <p>{path.description}</p>
            <div class="topic-list">
              {path.steps.map((step) => <span class="chip">{step}</span>)}
            </div>
            <a class="button" href={withBase(path.href)}>
              Начать маршрут <ArrowRight size={18} aria-hidden="true" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section id="sections" class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Три главные темы</p>
        <h2>Разделы портала</h2>
      </div>
      <p>Каждый раздел собирает статьи, термины, реальные объекты и надежные внешние источники.</p>
    </div>
    <div class="grid three">
      {sections.map((section) => <SectionCard section={section} />)}
    </div>
  </section>

  <section class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Популярные материалы</p>
        <h2>Статьи для погружения</h2>
      </div>
      <p>Фильтруйте материалы по направлению или ищите по объектам, явлениям и методам наблюдения.</p>
    </div>
    <FilterControls />
    <div class="grid three" style="margin-top: 18px">
      {articles.map((article) => <ArticleCard article={article} />)}
    </div>
    <p class="empty-state" data-empty-state>По этому запросу материалов пока нет.</p>
  </section>

  <section class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Каталог объектов</p>
        <h2>Опорные примеры</h2>
      </div>
      <p>Объекты связывают теорию с конкретными наблюдениями, миссиями и измерениями.</p>
    </div>
    <div class="grid three">
      {objects.map((object) => (
        <article class="card object-card">
          <div class="card-body">
            <div class="article-meta"><span>{object.category}</span></div>
            <h3>{object.name}</h3>
            <p>{object.summary}</p>
            <div class="topic-list">
              {object.keyFacts.map((fact) => <span class="chip">{fact}</span>)}
            </div>
            <div class="topic-list" aria-label={`Статьи по теме ${object.name}`}>
              {object.relatedArticles.map((slug) => (
                <a class="chip" href={withBase(`/articles/${slug}/`)}>
                  {articles.find((article) => article.id === slug)?.data.title ?? slug}
                </a>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Быстрый вход</p>
        <h2>Глоссарий, карта знаний и источники</h2>
      </div>
      <p>Короткие определения, связи между темами и ссылки на агентства, архивы, каталоги и миссии.</p>
    </div>
    <div class="hero-actions" style="margin-top: 0">
      <a class="button" href={withBase("/knowledge/")}>Открыть карту знаний <ArrowRight size={18} aria-hidden="true" /></a>
      <a class="button" href={withBase("/glossary/")}>Открыть глоссарий <ArrowRight size={18} aria-hidden="true" /></a>
      <a class="button" href={withBase("/materials/")}>Открыть материалы <ArrowRight size={18} aria-hidden="true" /></a>
    </div>
  </section>
</BaseLayout>
