<canvas class="live-cosmos" data-live-cosmos aria-hidden="true"></canvas>
<div class="cosmic-vignette" aria-hidden="true"></div>

<script>
  // @ts-nocheck
  const canvases = document.querySelectorAll("[data-live-cosmos]");

  canvases.forEach((canvas) => {
    if (canvas.dataset.ready === "true") return;
    canvas.dataset.ready = "true";

    const ctx = canvas.getContext("2d", { alpha: true });
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const pointer = { x: 0.5, y: 0.5, active: false };
    const palette = ["#ffffff", "#70d6ff", "#f6b35f", "#8bd88b"];
    const dustPalette = ["rgba(112, 214, 255,", "rgba(246, 179, 95,", "rgba(255, 255, 255,"];

    let width = 0;
    let height = 0;
    let dpr = 1;
    let stars = [];
    let dust = [];
    let glints = [];
    let planets = [];
    let raf = 0;
    let lastTime = 0;

    function random(min, max) {
      return min + Math.random() * (max - min);
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      seedScene();
      draw(performance.now());
    }

    function seedScene() {
      const sceneArea = width * height;
      const starCount = Math.min(260, Math.max(110, Math.floor(sceneArea / 6200)));
      const dustCount = Math.min(230, Math.max(90, Math.floor(sceneArea / 7800)));

      stars = Array.from({ length: starCount }, (_, index) => ({
        x: Math.random() * width,
        y: Math.random() * height,
        baseX: Math.random() * width,
        baseY: Math.random() * height,
        radius: random(0.55, index % 9 === 0 ? 2.1 : 1.35),
        depth: random(0.18, 1),
        phase: random(0, Math.PI * 2),
        speed: random(0.25, 0.9),
        color: palette[Math.floor(Math.random() * palette.length)],
        link: index % 7 === 0
      }));

      dust = Array.from({ length: dustCount }, (_, index) => {
        const along = random(-0.18, 1.18);
        const spread = random(-height * 0.22, height * 0.22);
        const x = width * along + spread * 0.34;
        const y = height * (0.18 + along * 0.62) + spread;

        return {
          baseX: x,
          baseY: y,
          x,
          y,
          radius: random(0.35, index % 8 === 0 ? 1.7 : 1.05),
          depth: random(0.12, 0.82),
          phase: random(0, Math.PI * 2),
          speed: random(0.08, 0.38),
          opacity: random(0.05, 0.2),
          color: dustPalette[Math.floor(Math.random() * dustPalette.length)]
        };
      });

      glints = [
        { delay: 0, duration: 17000, y: 0.16, length: 220, alpha: 0.5, speed: 1 },
        { delay: 6200, duration: 22000, y: 0.48, length: 290, alpha: 0.42, speed: 0.78 },
        { delay: 11800, duration: 26000, y: 0.74, length: 190, alpha: 0.38, speed: 0.9 }
      ];

      planets = [
        { orbit: Math.min(width, height) * 0.3, angle: 0.2, speed: 0.045, size: 3.2, color: "#f6b35f" },
        { orbit: Math.min(width, height) * 0.43, angle: 2.4, speed: -0.027, size: 2.6, color: "#70d6ff" },
        { orbit: Math.min(width, height) * 0.55, angle: 4.6, speed: 0.018, size: 2.2, color: "#8bd88b" }
      ];
    }

    function drawNebula(time) {
      const drift = Math.sin(time * 0.00012) * 60;
      const glowOne = ctx.createRadialGradient(width * 0.2 + drift, height * 0.18, 0, width * 0.2 + drift, height * 0.18, width * 0.42);
      glowOne.addColorStop(0, "rgba(112, 214, 255, 0.12)");
      glowOne.addColorStop(1, "rgba(112, 214, 255, 0)");
      ctx.fillStyle = glowOne;
      ctx.fillRect(0, 0, width, height);

      const glowTwo = ctx.createRadialGradient(width * 0.82 - drift, height * 0.32, 0, width * 0.82 - drift, height * 0.32, width * 0.34);
      glowTwo.addColorStop(0, "rgba(246, 179, 95, 0.09)");
      glowTwo.addColorStop(1, "rgba(246, 179, 95, 0)");
      ctx.fillStyle = glowTwo;
      ctx.fillRect(0, 0, width, height);

      const band = ctx.createLinearGradient(width * 0.04, height * 0.02, width * 0.92, height * 0.86);
      band.addColorStop(0, "rgba(255, 255, 255, 0)");
      band.addColorStop(0.38, "rgba(112, 214, 255, 0.055)");
      band.addColorStop(0.5, "rgba(255, 255, 255, 0.08)");
      band.addColorStop(0.62, "rgba(246, 179, 95, 0.045)");
      band.addColorStop(1, "rgba(255, 255, 255, 0)");
      ctx.save();
      ctx.translate(width * 0.5, height * 0.5);
      ctx.rotate(-0.28);
      ctx.fillStyle = band;
      ctx.fillRect(-width * 0.68, -height * 0.22, width * 1.36, height * 0.44);
      ctx.restore();
    }

    function drawDust(delta) {
      const parallaxX = (pointer.x - 0.5) * 44;
      const parallaxY = (pointer.y - 0.5) * 34;

      dust.forEach((particle) => {
        particle.phase += delta * 0.001 * particle.speed;
        particle.x = particle.baseX + parallaxX * particle.depth + Math.cos(particle.phase) * 4 * particle.depth;
        particle.y = particle.baseY + parallaxY * particle.depth + Math.sin(particle.phase * 0.9) * 5 * particle.depth;

        ctx.fillStyle = `${particle.color} ${particle.opacity})`;
        ctx.beginPath();
        ctx.arc(particle.x, particle.y, particle.radius, 0, Math.PI * 2);
        ctx.fill();
      });
    }

    function drawConstellations() {
      const linkStars = stars.filter((star) => star.link).slice(0, 34);
      ctx.lineWidth = 1;

      for (let index = 0; index < linkStars.length - 1; index += 1) {
        const current = linkStars[index];
        const next = linkStars[index + 1];
        const distance = Math.hypot(current.x - next.x, current.y - next.y);

        if (distance < Math.min(width, 360)) {
          ctx.strokeStyle = `rgba(112, 214, 255, ${Math.max(0, 0.16 - distance / 2600)})`;
          ctx.beginPath();
          ctx.moveTo(current.x, current.y);
          ctx.lineTo(next.x, next.y);
          ctx.stroke();
        }
      }
    }

    function drawEcliptic(time) {
      const baseX = width * 0.62 + (pointer.x - 0.5) * 18;
      const baseY = height * 0.58 + (pointer.y - 0.5) * 14;

      ctx.save();
      ctx.translate(baseX, baseY);
      ctx.rotate(-0.2 + Math.sin(time * 0.00005) * 0.04);
      for (let index = 0; index < 4; index += 1) {
        const radiusX = width * (0.34 + index * 0.1);
        const radiusY = radiusX * (0.24 + index * 0.025);
        ctx.strokeStyle = `rgba(255, 255, 255, ${0.035 - index * 0.004})`;
        ctx.lineWidth = 1;
        ctx.setLineDash([6, 16 + index * 4]);
        ctx.lineDashOffset = -time * (0.006 + index * 0.0015);
        ctx.beginPath();
        ctx.ellipse(0, 0, radiusX, radiusY, 0, 0, Math.PI * 2);
        ctx.stroke();
      }
      ctx.setLineDash([]);
      ctx.restore();
    }

    function drawGlints(time) {
      glints.forEach((glint) => {
        const cycle = ((time + glint.delay) % glint.duration) / glint.duration;
        if (cycle < 0.58 || cycle > 0.9) return;

        const local = (cycle - 0.58) / 0.32;
        const x = -glint.length + local * (width + glint.length * 1.8) * glint.speed;
        const y = height * glint.y + Math.sin(local * Math.PI) * height * 0.08;
        const alpha = Math.sin(local * Math.PI) * glint.alpha;
        const gradient = ctx.createLinearGradient(x, y, x + glint.length, y + glint.length * 0.2);

        gradient.addColorStop(0, "rgba(255, 255, 255, 0)");
        gradient.addColorStop(0.46, `rgba(255, 255, 255, ${alpha})`);
        gradient.addColorStop(1, "rgba(112, 214, 255, 0)");
        ctx.strokeStyle = gradient;
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        ctx.moveTo(x, y);
        ctx.lineTo(x + glint.length, y + glint.length * 0.2);
        ctx.stroke();
      });
    }

    function drawPlanets(time) {
      const centerX = width * 0.76 + (pointer.x - 0.5) * 28;
      const centerY = height * 0.33 + (pointer.y - 0.5) * 22;

      planets.forEach((planet) => {
        planet.angle += planet.speed * 0.016;
        const orbitY = planet.orbit * 0.42;
        const x = centerX + Math.cos(planet.angle + time * 0.00022) * planet.orbit;
        const y = centerY + Math.sin(planet.angle + time * 0.00022) * orbitY;

        ctx.strokeStyle = "rgba(255, 255, 255, 0.055)";
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.ellipse(centerX, centerY, planet.orbit, orbitY, -0.22, 0, Math.PI * 2);
        ctx.stroke();

        const gradient = ctx.createRadialGradient(x - planet.size, y - planet.size, 0, x, y, planet.size * 4);
        gradient.addColorStop(0, "rgba(255, 255, 255, 0.85)");
        gradient.addColorStop(0.28, planet.color);
        gradient.addColorStop(1, "rgba(112, 214, 255, 0)");
        ctx.fillStyle = gradient;
        ctx.beginPath();
        ctx.arc(x, y, planet.size * 3.5, 0, Math.PI * 2);
        ctx.fill();
      });
    }

    function draw(time) {
      const delta = Math.min(40, time - lastTime || 16);
      lastTime = time;

      ctx.clearRect(0, 0, width, height);
      drawNebula(time);
      drawEcliptic(time);
      drawDust(delta);

      const parallaxX = (pointer.x - 0.5) * 30;
      const parallaxY = (pointer.y - 0.5) * 24;

      stars.forEach((star) => {
        star.phase += delta * 0.001 * star.speed;
        star.x = star.baseX + parallaxX * star.depth;
        star.y = star.baseY + parallaxY * star.depth + Math.sin(star.phase * 0.55) * star.depth * 1.2;

        const twinkle = 0.42 + Math.sin(star.phase) * 0.28 + star.depth * 0.3;
        ctx.globalAlpha = Math.max(0.12, Math.min(0.95, twinkle));
        ctx.fillStyle = star.color;
        ctx.beginPath();
        ctx.arc(star.x, star.y, star.radius, 0, Math.PI * 2);
        ctx.fill();
      });

      ctx.globalAlpha = 1;
      drawConstellations();
      drawPlanets(time);
      drawGlints(time);

      if (!reducedMotion.matches) {
        raf = requestAnimationFrame(draw);
      }
    }

    function updatePointer(event) {
      pointer.active = true;
      pointer.x = event.clientX / Math.max(1, width);
      pointer.y = event.clientY / Math.max(1, height);
    }

    window.addEventListener("resize", resize, { passive: true });
    window.addEventListener("pointermove", updatePointer, { passive: true });
    reducedMotion.addEventListener?.("change", () => {
      cancelAnimationFrame(raf);
      draw(performance.now());
    });

    resize();
  });
</script>
