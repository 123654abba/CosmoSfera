---
import { assetPath, withBase } from "../utils/paths";

interface Props {
  section: {
    title: string;
    short: string;
    description: string;
    href: string;
    image: string;
    imageAlt: string;
    accent: string;
    icon: any;
    topics: readonly string[];
  };
  variant?: "visual" | "textual";
}

const { section, variant = "visual" } = Astro.props;
const Icon = section.icon;
---

<article class={`card section-card section-card--${variant}`} style={`--accent: ${section.accent}`}>
  <a class="card-link" href={withBase(section.href)} aria-label={`Открыть раздел ${section.title}`}></a>
  {variant === "visual" && <img src={assetPath(section.image)} alt={section.imageAlt} loading="eager" decoding="async" />}
  <div class="card-body">
    <div class="card-kicker" style="color: var(--accent)">
      <Icon size={19} aria-hidden="true" />
      <span>{section.short}</span>
    </div>
    <h3>{section.title}</h3>
    <p>{section.description}</p>
    <div class="topic-list" aria-label={`Темы раздела ${section.title}`}>
      {section.topics.map((topic) => <span class="chip">{topic}</span>)}
    </div>
  </div>
</article>
