---
import { withBase } from "../utils/paths";

interface Props {
  section: {
    title: string;
    short: string;
    description: string;
    href: string;
    image: string;
    imageAlt: string;
    accent: string;
    icon: any;
    topics: readonly string[];
  };
}

const { section } = Astro.props;
const Icon = section.icon;
---

<article class="card section-card" style={`--accent: ${section.accent}`}>
  <a href={withBase(section.href)}>
    <img src={section.image} alt={section.imageAlt} loading="lazy" />
  </a>
  <div class="card-body">
    <div class="card-kicker" style="color: var(--accent)">
      <Icon size={19} aria-hidden="true" />
      <span>{section.short}</span>
    </div>
    <h3><a href={withBase(section.href)}>{section.title}</a></h3>
    <p>{section.description}</p>
    <div class="topic-list" aria-label={`Темы раздела ${section.title}`}>
      {section.topics.map((topic) => <span class="chip">{topic}</span>)}
    </div>
  </div>
</article>
