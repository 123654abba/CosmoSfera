---
import { ArrowRight, Clock3 } from "lucide-astro";
import { withBase } from "../utils/paths";

const milestones = [
  {
    time: "13,8 млрд лет назад",
    title: "Появляется сцена",
    label: "Ранняя Вселенная",
    description:
      "Вселенная расширяется и остывает. Пока нет планет и сложной химии, но возникает основа для будущих звезд, галактик и тяжелых элементов.",
    scale: "0%",
    href: "/articles/galaxies-and-scale/"
  },
  {
    time: "Первые сотни млн лет",
    title: "Звезды создают химию",
    label: "Первые звезды",
    description:
      "Звезды и сверхновые обогащают космос тяжелыми элементами. Без этой химии не было бы каменистых планет, льда, атмосферы и сложных молекул.",
    scale: "29%",
    href: "/articles/cosmic-cliffs/"
  },
  {
    time: "Около 9 млрд лет назад",
    title: "Формируются миры",
    label: "Планетные миры",
    description:
      "Из газа и пыли вокруг молодой звезды формируются планеты, спутники, астероиды и кометы. У каждого мира появляется своя тепловая и геологическая история.",
    scale: "58%",
    href: "/articles/planetary-surfaces/"
  },
  {
    time: "После формирования систем",
    title: "Океаны и атмосферы",
    label: "Среды обитаемости",
    description:
      "Вода, лед, атмосферы, приливный нагрев и химический обмен создают разные сценарии потенциально обитаемых сред: от Марса до Европы и экзопланет.",
    scale: "76%",
    href: "/articles/icy-moons/"
  },
  {
    time: "Сегодня",
    title: "Эпоха проверки",
    label: "Спектры и миссии",
    description:
      "Космические телескопы, спектры, марсоходы и архивы данных позволяют проверять гипотезы об атмосферах, воде, минералах и источниках энергии.",
    scale: "100%",
    href: "/articles/spectra/"
  }
];
---

<section class="container universe-lab" id="cosmic-timeline" data-timeline-root>
  <div class="section-heading">
    <div>
      <p class="eyebrow">Интерактив</p>
      <h2>Шкала обитаемых миров</h2>
    </div>
    <p>Короткий маршрут от ранней Вселенной к химии, планетам, океанам, атмосферам и современным проверкам.</p>
  </div>

  <div class="timeline-shell">
    <div class="timeline-visual" aria-hidden="true">
      <div class="timeline-orbit">
        <span class="timeline-world"></span>
        <span class="timeline-ring timeline-ring-one"></span>
        <span class="timeline-ring timeline-ring-two"></span>
      </div>
      <div class="timeline-scale">
        <span data-timeline-fill style={`width: ${milestones[0].scale}`}></span>
      </div>
    </div>

    <div class="timeline-content">
      <div class="timeline-detail">
        <div class="card-kicker">
          <Clock3 size={18} aria-hidden="true" />
          <span data-timeline-time>{milestones[0].time}</span>
        </div>
        <h3 data-timeline-title>{milestones[0].title}</h3>
        <p data-timeline-description>{milestones[0].description}</p>
        <a class="button" href={withBase(milestones[0].href)} data-timeline-link>
          Читать связанную статью <ArrowRight size={18} aria-hidden="true" />
        </a>
      </div>

      <div class="timeline-buttons" role="list" aria-label="Этапы формирования условий для обитаемых миров">
        {milestones.map((item, index) => (
          <button
            class="timeline-button"
            type="button"
            role="listitem"
            aria-pressed={index === 0 ? "true" : "false"}
            data-timeline-item
            data-time={item.time}
            data-title={item.title}
            data-description={item.description}
            data-scale={item.scale}
            data-href={withBase(item.href)}
          >
            <span>{item.label}</span>
            <small>{item.time}</small>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const timelineRoot = document.querySelector<HTMLElement>("[data-timeline-root]");
  const timelineButtons = Array.from(timelineRoot?.querySelectorAll<HTMLButtonElement>("[data-timeline-item]") ?? []);
  const timelineTime = timelineRoot?.querySelector<HTMLElement>("[data-timeline-time]");
  const timelineTitle = timelineRoot?.querySelector<HTMLElement>("[data-timeline-title]");
  const timelineDescription = timelineRoot?.querySelector<HTMLElement>("[data-timeline-description]");
  const timelineFill = timelineRoot?.querySelector<HTMLElement>("[data-timeline-fill]");
  const timelineLink = timelineRoot?.querySelector<HTMLAnchorElement>("[data-timeline-link]");

  function activateTimelineItem(button: HTMLButtonElement) {
    timelineButtons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));

    if (timelineTime) timelineTime.textContent = button.dataset.time ?? "";
    if (timelineTitle) timelineTitle.textContent = button.dataset.title ?? "";
    if (timelineDescription) timelineDescription.textContent = button.dataset.description ?? "";
    if (timelineFill) timelineFill.style.width = button.dataset.scale ?? "0%";
    if (timelineLink) timelineLink.href = button.dataset.href ?? timelineLink.href;
  }

  timelineButtons.forEach((button) => {
    button.addEventListener("click", () => activateTimelineItem(button));
  });
</script>
